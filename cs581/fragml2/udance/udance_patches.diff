diff --git a/uDance/create_concat_alignment.sh b/uDance/create_concat_alignment.sh
index 133ff57..00ac684 100644
--- a/uDance/create_concat_alignment.sh
+++ b/uDance/create_concat_alignment.sh
@@ -33,7 +33,8 @@ ls $ALNDIR | while read aln; do
     echo $TDR/$aln.gz >> $TDR/alnpaths.txt
 done
 # concatenate all alignments
-seqkit concat --quiet -w 0 $(cat $TDR/alnpaths.txt) | gzip -c - > $TDR/concat.fa.gz
+if [ $(wc -l < $TDR/alnpaths.txt) -eq 1 ]; then cp $(cat $TDR/alnpaths.txt) $TDR/concat.fa.gz; else
+seqkit concat --quiet -w 0 $(cat $TDR/alnpaths.txt) | gzip -c - > $TDR/concat.fa.gz; fi  # PATCH(cs581): single-gene support
 # order it so that bacbone sequences are the first N records
 (seqkit grep -f <(nw_labels -I $BBONE) -w 0 --quiet $TDR/concat.fa.gz; seqkit grep -v -f <(nw_labels -I $BBONE) -w 0 --quiet $TDR/concat.fa.gz) | gzip -c - >  $TDR/concat_ordered.fa.gz
 # Duplicate map is written to OUTDIR.
