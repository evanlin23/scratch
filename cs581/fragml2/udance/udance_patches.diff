+        gt_labels = set()
+        for t_ in confident_trees.values():
+            gt_labels.update(t_.labels(internal=False))
+        for mtd_ in ['incremental', 'updates']:
+            cp_ = astral_const_file[mtd_]
+            if Path(cp_).is_file():
+                ct_ = ts.read_tree_newick(cp_)
+                extra_ = set(ct_.labels(internal=False)) - gt_labels
+                if extra_:
+                    print('PATCH: pruning %s from %s' % (sorted(extra_), cp_), file=stderr)
+                    ct_ = ct_.extract_tree_without(list(extra_))
+                    ct_.suppress_unifurcations()
+                    pruned_ = cp_ + '.pruned.nwk'
+                    with open(pruned_, 'w') as f_:
+                        f_.write(str(ct_) + '\n')
+                    astral_const_file[mtd_] = pruned_
